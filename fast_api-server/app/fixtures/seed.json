 "decisions": [
  {
   "id": "dec_r1",
   "topic_id": "top_retry",
   "meeting_id": "mtg_ret",
   "statement": "Retry failed webhooks three times with jitter, then dead-letter",
   "short_title": "3 retries then dead-letter",
   "quote": "Three attempts with jitter, and after that it goes to the dead-letter queue. No infinite loops.",
   "quote_lang": "en",
   "speaker_id": "per_priya",
   "offset_sec": 600,
   "owner_id": "per_jinwoo",
   "owner_confidence": 1.0,
   "deadline": "2026-10-14",
   "status": "ACTIVE",
   "conflict_state": "NONE",
   "task_title": "Implement the webhook retry handler",
   "task_short": "Retry handler"
  },
  {
   "id": "dec_r2",
   "topic_id": "top_retry",
   "meeting_id": "mtg_ret",
   "statement": "Cap retries per request across all attempts, not per attempt",
   "short_title": "Per-request retry budget",
   "quote": "リトライ予算はリクエスト全体で数えます。試行ごとではありません。",
   "quote_lang": "ja",
   "speaker_id": "per_priya",
   "offset_sec": 1500,
   "owner_id": "per_priya",
   "owner_confidence": 1.0,
   "deadline": "2026-10-20",
   "status": "ACTIVE",
   "conflict_state": "NONE",
   "translation": "The retry budget is counted per request overall, not per attempt.",
   "task_title": "Add the retry budget to the client",
   "task_short": "Retry budget"
  },
  {
   "id": "dec_a1",
   "topic_id": "top_api",
   "meeting_id": "mtg_api",
   "statement": "Version the public API in the URL path from v2 onward",
   "short_title": "Version API in URL path",
   "quote": "v2 and up live in the path. Headers are too easy to lose behind a proxy.",
   "quote_lang": "en",
   "speaker_id": "per_rahul",
   "offset_sec": 540,
   "owner_id": "per_jinwoo",
   "owner_confidence": 1.0,
   "deadline": "2026-10-14",
   "status": "ACTIVE",
   "conflict_state": "NONE",
   "task_title": "Publish the API versioning proposal",
   "task_short": "API versioning"
  },
  {
   "id": "dec_a2",
   "topic_id": "top_api",
   "meeting_id": "mtg_api",
   "statement": "Keep v1 endpoints alive for six months after v2 ships",
   "short_title": "v1 sunset in six months",
   "quote": "v1 stays for six months after v2 ships, then we announce the sunset.",
   "quote_lang": "en",
   "speaker_id": "per_kobayashi",
   "offset_sec": 1100,
   "owner_id": "per_rahul",
   "owner_confidence": 1.0,
   "deadline": "2027-05-15",
   "status": "ACTIVE",
   "conflict_state": "NONE"
  },
  {
   "id": "dec_l2",
   "topic_id": "top_ledger",
   "meeting_id": "mtg_sec",
   "statement": "Encrypt ledger entries at rest with per-tenant keys",
   "short_title": "Per-tenant ledger keys",
   "quote": "Per-tenant keys for the ledger. Omar will own the key rotation story.",
   "quote_lang": "en",
   "speaker_id": "per_omar",
   "offset_sec": 1750,
   "owner_id": "per_omar",
   "owner_confidence": 1.0,
   "deadline": "2026-10-25",
   "status": "ACTIVE",
   "conflict_state": "NONE",
   "task_title": "Design per-tenant key rotation",
   "task_short": "Key rotation"
  },
  {
   "id": "dec_d1",
   "topic_id": "top_launch",
   "meeting_id": "mtg_qp",
   "statement": "Target an early November launch",
   "short_title": "Early November target",
   "quote": "Early November is the target. Let’s work back from there.",
   "quote_lang": "en",
   "speaker_id": "per_mei",
   "offset_sec": 840,
   "owner_id": "per_mei",
   "owner_confidence": 1.0,
   "deadline": "2026-11-05",
   "status": "SUPERSEDED",
   "conflict_state": "NONE"
  },
  {
   "id": "dec_v1",
   "topic_id": "top_launch",
   "meeting_id": "mtg_vr",
   "statement": "Vendor sandbox certification must pass before any launch date is final",
   "short_title": "Certification gates launch",
   "quote": "Nothing ships until the sandbox certification run is green. That is the gate.",
   "quote_lang": "en",
